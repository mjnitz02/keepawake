#!/bin/bash
#
# keepawake-daemon
#
# Runs as root under launchd. Its only job is to keep the kernel's
# "SleepDisabled" flag in the state we want, and to put it back whenever
# something else (Jamf, a macOS update, a user running pmset) changes it.
#
# Why SleepDisabled and not caffeinate:
#   caffeinate creates an IOKit power assertion. Assertions block *idle*
#   sleep only. They do not block 'Clamshell Sleep', which is what fires
#   when the lid is shut and macOS decides the external display went away.
#   SleepDisabled is the one supported knob that suppresses that path.
#
# Safety: we only hold the flag while the machine is on AC power, above a
# battery floor, and not thermally throttled. Unplugging the power cable is
# therefore enough to make the Mac sleepable again, which covers the
# "threw it in a bag without turning this off" case.

set -u

# Paths are overridable only so the test suite can point them at a scratch
# directory. launchd controls this daemon's environment, so nothing sets these
# in the real install.
STATE_DIR="${KEEPAWAKE_STATE_DIR:-/usr/local/var/keepawake}"
STATE_FILE="$STATE_DIR/state"
NUDGE_FILE="$STATE_DIR/nudge"
NUDGE_LAST_FILE="$STATE_DIR/nudge.last"
STATUS_FILE="$STATE_DIR/status.json"
CONF_FILE="$STATE_DIR/config"
LOG_FILE="${KEEPAWAKE_LOG_FILE:-/usr/local/var/log/keepawake.log}"

# Defaults, overridable from $CONF_FILE.
INTERVAL=2          # seconds between checks
BATT_FLOOR=30       # let the Mac sleep if battery drops below this, even on AC
THERM_FLOOR=50      # let the Mac sleep if CPU speed limit falls below this %
LOG_MAX_BYTES=1048576

# shellcheck source=/dev/null
[ -r "$CONF_FILE" ] && . "$CONF_FILE"

PMSET=/usr/bin/pmset

log() {
  if [ -f "$LOG_FILE" ]; then
    size=$(/usr/bin/stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$size" -gt "$LOG_MAX_BYTES" ]; then
      /bin/mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null
    fi
  fi
  printf '%s  %s\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"
}

# --- readers -----------------------------------------------------------------

# Sets AC=0|1 and BATT=<percent>.
read_power() {
  out=$($PMSET -g batt 2>/dev/null)
  case "$out" in
    *"'AC Power'"*) AC=1 ;;
    *)              AC=0 ;;
  esac
  BATT=$(printf '%s' "$out" | /usr/bin/sed -n 's/.*[^0-9]\([0-9][0-9]*\)%.*/\1/p' | /usr/bin/head -1)
  # No battery, or unparseable output: don't let that trip the floor guard.
  case "$BATT" in
    ''|*[!0-9]*) BATT=100 ;;
  esac
}

# Current kernel flag: 0 or 1.
read_sleep_disabled() {
  $PMSET -g 2>/dev/null | /usr/bin/awk '/SleepDisabled/{print $2; exit}'
}

# True when the lid is shut. Costs about 20ms.
lid_closed() {
  /usr/sbin/ioreg -r -k AppleClamshellState -d 4 2>/dev/null \
    | /usr/bin/grep -m1 '"AppleClamshellState"' \
    | /usr/bin/grep -q Yes
}

# pmset only reports a speed limit once the machine has actually throttled,
# so "nothing recorded" is the healthy case. Fail open on anything odd.
thermal_ok() {
  lim=$($PMSET -g therm 2>/dev/null | /usr/bin/awk -F'= *' '/CPU_Speed_Limit/{print $2; exit}')
  case "$lim" in
    ''|*[!0-9]*) return 0 ;;
  esac
  [ "$lim" -ge "$THERM_FLOOR" ]
}

# Two guard chains now ask the same thermal question each pass. Memoize it so
# that costs one pmset call per loop instead of two, and still costs nothing at
# all on the common path where an earlier guard already decided the answer.
THERM_CACHE=""
thermal_ok_cached() {
  if [ -z "$THERM_CACHE" ]; then
    if thermal_ok; then THERM_CACHE=1; else THERM_CACHE=0; fi
  fi
  [ "$THERM_CACHE" = "1" ]
}

read_desired() {
  if [ -r "$STATE_FILE" ]; then
    /usr/bin/head -c 16 "$STATE_FILE" 2>/dev/null | /usr/bin/tr -d '[:space:]'
  else
    printf 'off'
  fi
}

# Sets NUDGE_DESIRED (on|off) and NUDGE_EXPIRES (epoch, or 0 for no expiry).
# File format is one line: "off", "on 0", or "on <expiry-epoch>".
read_nudge() {
  NUDGE_DESIRED=off
  NUDGE_EXPIRES=0
  [ -r "$NUDGE_FILE" ] || return 0
  line=$(/usr/bin/head -c 64 "$NUDGE_FILE" 2>/dev/null | /usr/bin/tr -d '\n')
  word=${line%% *}
  [ "$word" = "on" ] || return 0
  NUDGE_DESIRED=on
  rest=${line#"$word"}
  rest=${rest# }
  rest=${rest%% *}
  case "$rest" in
    ''|*[!0-9]*) NUDGE_EXPIRES=0 ;;
    *)           NUDGE_EXPIRES=$rest ;;
  esac
}

# Nudge mode latches OFF rather than being held off, which is the one place it
# deliberately differs from the sleep block. The sleep block resumes by itself
# when you plug back in, because that is a standing preference. Nudging is a
# thing you switched on for one evening, so a machine that starts moving its own
# cursor again just because it found a power outlet is wrong. Unplugging ends
# the session, full stop, and turning it back on is a deliberate act.
nudge_latch_off() {
  printf 'off' >"$NUDGE_FILE" 2>/dev/null
  printf '%s %s' "$1" "$(/bin/date '+%s')" >"$NUDGE_LAST_FILE" 2>/dev/null
  /bin/chmod 644 "$NUDGE_LAST_FILE" 2>/dev/null
  log "nudge switched OFF automatically (reason=$1 ac=$AC batt=${BATT}%)"
  NUDGE_DESIRED=off
  NUDGE_EXPIRES=0
}

# What turned nudge off last, so `keepawake status` can say why rather than
# just showing a switch the user did not flip.
read_nudge_last() {
  NUDGE_OFF_REASON=""
  NUDGE_OFF_EPOCH=0
  [ -r "$NUDGE_LAST_FILE" ] || return 0
  line=$(/usr/bin/head -c 64 "$NUDGE_LAST_FILE" 2>/dev/null | /usr/bin/tr -d '\n')
  NUDGE_OFF_REASON=${line%% *}
  rest=${line#"$NUDGE_OFF_REASON"}
  rest=${rest# }
  case "$rest" in
    ''|*[!0-9]*) NUDGE_OFF_EPOCH=0 ;;
    *)           NUDGE_OFF_EPOCH=$rest ;;
  esac
}

# --- writers -----------------------------------------------------------------

apply() {
  want=$1
  $PMSET -a disablesleep "$want" >/dev/null 2>&1
  rc=$?
  if [ $rc -ne 0 ]; then
    log "ERROR pmset -a disablesleep $want failed (rc=$rc)"
  fi
  return $rc
}

write_status() {
  local active reason sdflag
  active=$1; reason=$2; sdflag=${3:-0}
  /bin/cat >"$STATUS_FILE.tmp" <<EOF
{
  "desired": "$DESIRED",
  "active": $active,
  "reason": "$reason",
  "ac": $( [ "$AC" = 1 ] && echo true || echo false ),
  "battery": $BATT,
  "sleep_disabled": $sdflag,
  "nudge_desired": "$NUDGE_DESIRED",
  "nudge_active": $( [ "$NUDGE_REASON" = "ok" ] && echo true || echo false ),
  "nudge_reason": "$NUDGE_REASON",
  "nudge_expires_epoch": $NUDGE_EXPIRES,
  "nudge_off_reason": "$NUDGE_OFF_REASON",
  "nudge_off_epoch": $NUDGE_OFF_EPOCH,
  "updated": "$(/bin/date '+%Y-%m-%d %H:%M:%S')",
  "updated_epoch": $(/bin/date '+%s')
}
EOF
  /bin/mv -f "$STATUS_FILE.tmp" "$STATUS_FILE"
  /bin/chmod 644 "$STATUS_FILE" 2>/dev/null
}

# --- decisions ---------------------------------------------------------------
#
# The two guard chains are split out from the loop and kept free of side
# effects, so the test suite can drive the whole decision table with fake power
# readings instead of needing a laptop it can unplug.

# Reads DESIRED, AC, BATT. Sets REASON and WANT (the SleepDisabled value).
decide_sleep_block() {
  REASON="ok"; WANT=1
  if [ "$DESIRED" != "on" ]; then
    REASON="off"; WANT=0
  elif [ "$AC" != "1" ]; then
    REASON="no-ac"; WANT=0
  elif [ "$BATT" -lt "$BATT_FLOOR" ]; then
    REASON="battery-low"; WANT=0
  elif ! thermal_ok_cached; then
    REASON="thermal"; WANT=0
  fi
}

# Reads NUDGE_DESIRED, NUDGE_EXPIRES, AC, BATT. Sets NUDGE_VERDICT to "off",
# "ok", or the name of the guard that fired. Deciding and latching are separate
# steps: this one only reports, the caller writes the file.
decide_nudge() {
  NUDGE_VERDICT="off"
  [ "$NUDGE_DESIRED" = "on" ] || return 0
  now_epoch=$(/bin/date '+%s')
  if [ "$NUDGE_EXPIRES" -gt 0 ] && [ "$now_epoch" -ge "$NUDGE_EXPIRES" ]; then
    NUDGE_VERDICT="expired"
  elif [ "$AC" != "1" ]; then
    NUDGE_VERDICT="no-ac"
  elif [ "$BATT" -lt "$BATT_FLOOR" ]; then
    NUDGE_VERDICT="battery-low"
  elif ! thermal_ok_cached; then
    NUDGE_VERDICT="thermal"
  else
    NUDGE_VERDICT="ok"
  fi
}

# Sourcing this file defines the functions above without starting a daemon.
# The test suite relies on this; nothing else sets it.
[ "${KEEPAWAKE_LIB_ONLY:-0}" = "1" ] && return 0

# --- lifecycle ---------------------------------------------------------------

# Always hand sleep back to macOS when we stop, however we stop.
cleanup() {
  trap - EXIT INT TERM
  apply 0
  log "daemon stopping; sleep re-enabled"
  AC=${AC:-0}; BATT=${BATT:-100}; DESIRED=${DESIRED:-off}
  # A stopped daemon must not leave nudge_active true in the status file: the
  # agent reads that field and would otherwise keep nudging with nothing left
  # to enforce the guards.
  NUDGE_DESIRED=${NUDGE_DESIRED:-off}; NUDGE_REASON="stopped"
  NUDGE_EXPIRES=${NUDGE_EXPIRES:-0}
  NUDGE_OFF_REASON=${NUDGE_OFF_REASON:-}; NUDGE_OFF_EPOCH=${NUDGE_OFF_EPOCH:-0}
  write_status false "stopped" 0
  exit 0
}
trap cleanup EXIT INT TERM

/bin/mkdir -p "$STATE_DIR" "$(/usr/bin/dirname "$LOG_FILE")"
[ -f "$STATE_FILE" ] || printf 'off' >"$STATE_FILE"
[ -f "$NUDGE_FILE" ] || printf 'off' >"$NUDGE_FILE"

log "daemon started (interval=${INTERVAL}s batt_floor=${BATT_FLOOR}% therm_floor=${THERM_FLOOR}%)"

last_reason=""
last_nudge_reason=""
last_flag=""
prev_ac=""

while :; do
  THERM_CACHE=""
  DESIRED=$(read_desired)
  read_power
  read_nudge
  read_nudge_last

  decide_sleep_block
  reason="$REASON"
  want="$WANT"

  # Nudge mode runs the same guards, but latches off instead of holding off.
  # Evaluated before the sleep block is applied so a single loop pass can both
  # release the flag and end the nudge session on the same unplug event.
  decide_nudge
  case "$NUDGE_VERDICT" in
    ok|off) NUDGE_REASON="$NUDGE_VERDICT" ;;
    *)      nudge_latch_off "$NUDGE_VERDICT"
            NUDGE_REASON="off"
            read_nudge_last ;;
  esac

  if [ "$NUDGE_REASON" != "$last_nudge_reason" ]; then
    log "nudge: desired=$NUDGE_DESIRED reason=$NUDGE_REASON expires=$NUDGE_EXPIRES"
  fi

  flag=$(read_sleep_disabled)
  case "$flag" in
    ''|*[!0-9]*) flag=0 ;;
  esac

  if [ "$flag" != "$want" ]; then
    # A mismatch while we still want the flag held is the interesting case:
    # something external reset it. Log it so there's a record of the sweep.
    if [ "$want" = "1" ] && [ "$last_flag" = "1" ]; then
      log "SleepDisabled was reset to $flag by something else; re-applying 1"
    else
      log "setting SleepDisabled=$want (reason=$reason ac=$AC batt=${BATT}%)"
    fi
    apply "$want"
    flag=$(read_sleep_disabled)
    case "$flag" in
      ''|*[!0-9]*) flag=0 ;;
    esac
  elif [ "$reason" != "$last_reason" ]; then
    log "state: desired=$DESIRED reason=$reason ac=$AC batt=${BATT}% flag=$flag"
  fi

  # Unplugging while the lid is already shut is the "packing up" gesture.
  # Releasing the flag is not enough on its own: the lid-close event that would
  # have slept the machine already fired while we were still holding the flag,
  # and with `sleep 0` configured on battery nothing comes along to retry it.
  # So on that specific transition, ask for sleep explicitly, once.
  if [ "$prev_ac" = "1" ] && [ "$AC" = "0" ] && [ "$want" = "0" ] && lid_closed; then
    log "AC lost with the lid closed; requesting sleep"
    $PMSET sleepnow >/dev/null 2>&1
  fi

  if [ "$want" = "1" ] && [ "$flag" = "1" ]; then
    write_status true "$reason" "$flag"
  else
    write_status false "$reason" "$flag"
  fi

  last_reason="$reason"
  last_nudge_reason="$NUDGE_REASON"
  last_flag="$flag"
  prev_ac="$AC"
  /bin/sleep "$INTERVAL"
done
